<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AdsbCarMap</RootNamespace>
    <ApplicationId>com.blackboltshadow.adsbcarmap</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2</ApplicationDisplayVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <AndroidKeyStore>true</AndroidKeyStore>
	  <AndroidSigningKeyStore>$(USERPROFILE)\adsbcarmap-release.jks</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>adsbcarmap</AndroidSigningKeyAlias>
  </PropertyGroup>
	
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	    <AndroidPackageFormat>aab</AndroidPackageFormat>
	    <AndroidKeyStore>true</AndroidKeyStore>
	    <AndroidSigningKeyStore>$(USERPROFILE)\adsbcarmap-release.jks</AndroidSigningKeyStore>
	    <AndroidSigningKeyAlias>adsbcarmap</AndroidSigningKeyAlias>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Car.App.App" Version="1.4.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
    <ApplicationVersion Condition="Exists('$(BuildNumberFile)')">$([MSBuild]::Add($([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim()), 1))</ApplicationVersion>
  </PropertyGroup>

  <Import Project="$(USERPROFILE)\adsbcarmap-contact.props" Condition="Exists('$(USERPROFILE)\adsbcarmap-contact.props')" />

  <Import Project="$(USERPROFILE)\adsbcarmap-signing.props" Condition="Exists('$(USERPROFILE)\adsbcarmap-signing.props')" />

  <PropertyGroup Condition="'$(AndroidSigningStorePass)' == ''">
    <AndroidSigningStorePass>$(ADSBCARMAP_STOREPASS)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(ADSBCARMAP_KEYPASS)</AndroidSigningKeyPass>
  </PropertyGroup>



  <Target Name="IncrementBuildNumber" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="PreviousBuildNumber" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <PreviousBuildNumber Condition="'$(PreviousBuildNumber)' == ''">0</PreviousBuildNumber>
      <BuildNumber>$(PreviousBuildNumber)</BuildNumber>
      <BuildNumber Condition="'$(DesignTimeBuild)' != 'true'">$([MSBuild]::Add($(PreviousBuildNumber), 1))</BuildNumber>
    </PropertyGroup>

    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" Condition="'$(DesignTimeBuild)' != 'true'" />

    <ItemGroup>
      <BuildInfoLine Include="namespace AdsbCarMap%3B" />
      <BuildInfoLine Include="/// &lt;summary&gt;" />
      <BuildInfoLine Include="/// Informacje o kompilacji generowane przy każdym buildzie." />
      <BuildInfoLine Include="/// &lt;/summary&gt;" />
      <BuildInfoLine Include="internal static class BuildInfo" />
      <BuildInfoLine Include="{" />
      <BuildInfoLine Include="    /// &lt;summary&gt;" />
      <BuildInfoLine Include="    /// Wersja aplikacji z numerem kompilacji zwiększanym przy każdym buildzie." />
      <BuildInfoLine Include="    /// &lt;/summary&gt;" />
      <BuildInfoLine Include="    public const string Version = &quot;$(ApplicationDisplayVersion).$(BuildNumber)&quot;%3B" />
      <BuildInfoLine Include="    /// &lt;summary&gt;" />
      <BuildInfoLine Include="    /// Kontakt wysyłany serwerom danych w nagłówku User-Agent, wczytywany z pliku użytkownika adsbcarmap-contact.props. Pusty, gdy pliku nie ma." />
      <BuildInfoLine Include="    /// &lt;/summary&gt;" />
      <BuildInfoLine Include="    public const string Contact = &quot;$(AdsbCarMapContact)&quot;%3B" />
      <BuildInfoLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
