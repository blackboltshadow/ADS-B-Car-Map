<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AdsbCarMap</RootNamespace>
    <ApplicationId>com.blackboltshadow.adsbcarmap</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2</ApplicationDisplayVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <AndroidKeyStore>true</AndroidKeyStore>
	  <AndroidSigningKeyStore>$(USERPROFILE)\adsbcarmap-release.jks</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>adsbcarmap</AndroidSigningKeyAlias>
  </PropertyGroup>
	
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	    <AndroidPackageFormat>aab</AndroidPackageFormat>
	    <AndroidKeyStore>true</AndroidKeyStore>
	    <AndroidSigningKeyStore>$(USERPROFILE)\adsbcarmap-release.jks</AndroidSigningKeyStore>
	    <AndroidSigningKeyAlias>adsbcarmap</AndroidSigningKeyAlias>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Car.App.App" Version="1.4.0.2" />
  </ItemGroup>

  <!-- The Car App library reads car-app-api.level from the package root at runtime. Without it Android Auto fails with "Car API level file car-app-api.level not found" (GET_APP_VERSION timeout). The file from the library jar is lost in some incremental builds, so the same file (content 7) is added to the package explicitly. -->
  <ItemGroup>
    <AndroidPackagingOptionsInclude Include="car-app-api.level" />
  </ItemGroup>

  <UsingTask TaskName="ZipContainsEntry" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ArchivePath ParameterType="System.String" Required="true" />
      <EntryName ParameterType="System.String" Required="true" />
      <Found ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (ZipArchive archive = ZipFile.OpenRead(ArchivePath))
        {
            Found = archive.GetEntry(EntryName) != null;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Fails the build when the finished package has no car-app-api.level, instead of letting Android Auto fail at runtime. CarAppApiLevelCheckFile can be set to check another file. -->
  <Target Name="VerifyCarAppApiLevel" AfterTargets="SignAndroidPackage" Condition="'$(AndroidPackageFormat)' == 'aab'">
    <PropertyGroup>
      <CarAppApiLevelCheckFile Condition="'$(CarAppApiLevelCheckFile)' == ''">$(_AabFileSigned)</CarAppApiLevelCheckFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(CarAppApiLevelCheckFile)')" Text="Package to verify not found: $(CarAppApiLevelCheckFile)" />
    <ZipContainsEntry ArchivePath="$(CarAppApiLevelCheckFile)" EntryName="base/root/car-app-api.level">
      <Output TaskParameter="Found" PropertyName="CarAppApiLevelFound" />
    </ZipContainsEntry>
    <Error Condition="'$(CarAppApiLevelFound)' != 'True'" Text="The package $(CarAppApiLevelCheckFile) has no base/root/car-app-api.level. Android Auto would fail with 'Car API level file car-app-api.level not found'. Check the AddCarAppApiLevelFile target in AdsbCarMap.csproj and Libs\car-app-api.level." />
  </Target>

  <Target Name="AddCarAppApiLevelFile" BeforeTargets="_BuildApkFastDev;_BuildApkEmbed">
    <ItemGroup>
      <FilesToAddToArchive Include="$(MSBuildProjectDirectory)\Libs\car-app-api.level">
        <ArchivePath>root/car-app-api.level</ArchivePath>
      </FilesToAddToArchive>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
    <ApplicationVersion Condition="Exists('$(BuildNumberFile)')">$([MSBuild]::Add($([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim()), 1))</ApplicationVersion>
  </PropertyGroup>

  <Import Project="$(USERPROFILE)\adsbcarmap-contact.props" Condition="Exists('$(USERPROFILE)\adsbcarmap-contact.props')" />

  <Import Project="$(USERPROFILE)\adsbcarmap-signing.props" Condition="Exists('$(USERPROFILE)\adsbcarmap-signing.props')" />

  <PropertyGroup Condition="'$(AndroidSigningStorePass)' == ''">
    <AndroidSigningStorePass>$(ADSBCARMAP_STOREPASS)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(ADSBCARMAP_KEYPASS)</AndroidSigningKeyPass>
  </PropertyGroup>



  <Target Name="IncrementBuildNumber" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="PreviousBuildNumber" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <PreviousBuildNumber Condition="'$(PreviousBuildNumber)' == ''">0</PreviousBuildNumber>
      <BuildNumber>$(PreviousBuildNumber)</BuildNumber>
      <BuildNumber Condition="'$(DesignTimeBuild)' != 'true'">$([MSBuild]::Add($(PreviousBuildNumber), 1))</BuildNumber>
    </PropertyGroup>

    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" Condition="'$(DesignTimeBuild)' != 'true'" />

    <ItemGroup>
      <BuildInfoLine Include="namespace AdsbCarMap" />
      <BuildInfoLine Include="{" />
      <BuildInfoLine Include="    /// &lt;summary&gt;" />
      <BuildInfoLine Include="    /// Build information generated on every build." />
      <BuildInfoLine Include="    /// &lt;/summary&gt;" />
      <BuildInfoLine Include="    internal static class BuildInfo" />
      <BuildInfoLine Include="    {" />
      <BuildInfoLine Include="        /// &lt;summary&gt;" />
      <BuildInfoLine Include="        /// Application version with the build number incremented on every build." />
      <BuildInfoLine Include="        /// &lt;/summary&gt;" />
      <BuildInfoLine Include="        public const string Version = &quot;$(ApplicationDisplayVersion).$(BuildNumber)&quot;%3B" />
      <BuildInfoLine Include="        /// &lt;summary&gt;" />
      <BuildInfoLine Include="        /// Contact sent to the data servers in the User-Agent header, loaded from the user file adsbcarmap-contact.props. Empty when the file does not exist." />
      <BuildInfoLine Include="        /// &lt;/summary&gt;" />
      <BuildInfoLine Include="        public const string Contact = &quot;$(AdsbCarMapContact)&quot;%3B" />
      <BuildInfoLine Include="    }" />
      <BuildInfoLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
